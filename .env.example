# AURORA LOGISTICS AI — variables de entorno
# Copie este archivo a `.env` en la raíz del repositorio y ajuste los valores.
# Nunca confirme el archivo `.env` real ni comparta sus credenciales.

# --- Identidad ---------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
APP_VERSION=0.1.0

# --- Base de datos -----------------------------------------------------------
# Desarrollo/pruebas: SQLite (ruta relativa al directorio backend/).
# Producción: PostgreSQL con psycopg.
DATABASE_URL=sqlite:///./data/aurora.db
# DATABASE_URL=postgresql+psycopg://aurora:CLAVE@db:5432/aurora

# --- Seguridad ---------------------------------------------------------------
# Obligatorio en producción: cadena aleatoria de al menos 32 caracteres.
JWT_SECRET=cambie-esta-clave-en-produccion
COOKIE_SECURE=false             # true en producción (HTTPS)
ACCESS_TOKEN_MINUTES=480
# Protege /metrics con 'Authorization: Bearer <token>'. Vacío = sin token.
METRICS_TOKEN=

# --- Arranque ----------------------------------------------------------------
AURORA_BOOTSTRAP=true           # crea esquema, triggers, roles y admin inicial
AURORA_RUN_MIGRATIONS=true     # aplica Alembic al arrancar
AURORA_ADMIN_EMAIL=admin@aurora.demo
AURORA_ADMIN_PASSWORD=Aurora2026!
AURORA_ADMIN_NAME=Elena Navarro

# --- Demostración ------------------------------------------------------------
DEMO_MODE=false                 # true solo con el dataset de scripts/seed_demo.py

# --- Trazas OpenTelemetry (opcional) ----------------------------------------
AURORA_TRACING_ENABLED=false
AURORA_TRACING_EXPORTER=otlp          # otlp | console
AURORA_TRACING_SAMPLE_RATIO=0.2
# Si está vacío se usan las variables estándar OTEL_EXPORTER_OTLP_*.
OTLP_ENDPOINT=

# --- Correo saliente (informes programados) ---------------------------------
# AURORA Voice: el navegador dicta y lee; el servidor solo interpreta el texto.
VOICE_PROVIDER=aurora-builtin
VOICE_LOCALE=es-ES

# Telefonía (Fase 8). handoff abre tel:/sip: en el dispositivo; webhook origina
# la llamada en un proveedor SIP/API real. Sin URL de webhook no se llama.
TELEPHONY_MODE=handoff
TELEPHONY_SIP_DOMAIN=
TELEPHONY_SIP_EXTENSION=
TELEPHONY_WEBHOOK_URL=
TELEPHONY_WEBHOOK_TOKEN=
# Secreto que debe enviar el proveedor en X-Telephony-Token o Bearer para
# confirmar estados de llamada en POST /api/v1/calls/callback.
TELEPHONY_CALLBACK_TOKEN=
TELEPHONY_WEBHOOK_TIMEOUT=10

# Sin SMTP_HOST no se envía nada; la interfaz lo muestra como no configurado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=aurora@suempresa.es
SMTP_STARTTLS=true
SMTP_SSL=false

# --- Documentos --------------------------------------------------------------
STORAGE_DIR=backend/data/storage
MAX_UPLOAD_MB=25

# --- Dominio -----------------------------------------------------------------
WAREHOUSE_TIMEZONE=Europe/Madrid
CORS_ORIGINS=http://localhost:3000
