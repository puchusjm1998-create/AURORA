# AURORA LOGISTICS AI — variables de entorno
# Copie este archivo a `.env` en la raíz del repositorio y ajuste los valores.
# Nunca confirme el archivo `.env` real ni comparta sus credenciales.

# --- Identidad ---------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
APP_VERSION=0.1.0

# --- Base de datos -----------------------------------------------------------
# Desarrollo/pruebas: SQLite (ruta relativa al directorio backend/).
# Producción: PostgreSQL con psycopg.
DATABASE_URL=sqlite:///./data/aurora.db
# DATABASE_URL=postgresql+psycopg://aurora:CLAVE@db:5432/aurora

# --- Seguridad ---------------------------------------------------------------
# Obligatorio en producción: cadena aleatoria de al menos 32 caracteres.
JWT_SECRET=cambie-esta-clave-en-produccion
COOKIE_SECURE=false             # true en producción (HTTPS)
ACCESS_TOKEN_MINUTES=480
# Protege /metrics con 'Authorization: Bearer <token>'. Vacío = sin token.
METRICS_TOKEN=

# --- Arranque ----------------------------------------------------------------
AURORA_BOOTSTRAP=true           # crea esquema, triggers, roles y admin inicial
AURORA_RUN_MIGRATIONS=true     # aplica Alembic al arrancar
AURORA_ADMIN_EMAIL=admin@aurora.demo
AURORA_ADMIN_PASSWORD=Aurora2026!
AURORA_ADMIN_NAME=Elena Navarro

# --- Demostración ------------------------------------------------------------
DEMO_MODE=false                 # true solo con el dataset de scripts/seed_demo.py

# --- Documentos --------------------------------------------------------------
STORAGE_DIR=backend/data/storage
MAX_UPLOAD_MB=25

# --- Dominio -----------------------------------------------------------------
WAREHOUSE_TIMEZONE=Europe/Madrid
CORS_ORIGINS=http://localhost:3000
